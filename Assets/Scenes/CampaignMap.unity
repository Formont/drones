  missionTitle: "\u0428\u043A\u043E\u043B\u0430 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430 \u0434\u0440\u043E\u043D\u0430"
  description: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0432\u044B\u0439 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u043B\u0435\u0442. \u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u0448\u0435\u0441\u0442\u044C \u0443\u0447\u0435\u0431\u043D\u044B\u0445 \u043A\u043E\u043B\u0435\u0446 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438, \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F \u0434\u0440\u043E\u043D \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0438 \u043E\u0431\u0445\u043E\u0434\u044F \u0437\u0434\u0430\u043D\u0438\u044F \u0438 \u043C\u0430\u0448\u0438\u043D\u044B. \u041B\u044E\u0431\u043E\u0435 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0443. \u041F\u043E\u0441\u043B\u0435 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0451\u0442\u0430 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u043E\u0442\u043A\u0440\u043E\u044E\u0442\u0441\u044F \u043D\u043E\u0432\u044B\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F."
  estimatedTime: "\u041E\u043A\u043E\u043B\u043E 4 \u043C\u0438\u043D\u0443\u0442"
